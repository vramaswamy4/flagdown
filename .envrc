# Per-project environment, auto-loaded by direnv when you cd into the repo.
# Go has no virtualenv — there is no interpreter or site-packages to isolate.
# This only scopes a couple of env vars to this directory.

# `go install` normally drops tool binaries in ~/go/bin, shared by every project.
# Point it at ./bin so this repo's codegen tools (protoc-gen-go, protoc-gen-go-grpc,
# mockgen) are pinned here and can't drift against another project's versions.
export GOBIN="$PWD/bin"
PATH_add "$PWD/bin"

# GOPATH is deliberately left global: it holds the shared module download cache,
# and a per-project copy would just re-download the same dependencies.
